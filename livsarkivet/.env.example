# Eier-tilkoblingen (migrasjoner og seeding). App-rollene utledes herfra
# hvis DATABASE_URL/_AUTH ikke er satt eksplisitt.
MIGRATE_DATABASE_URL=postgres://livsarkiv_eier:livsarkiv@localhost:5432/livsarkiv
# Passordene til app-rollene. `npm run migrate` setter dem i databasen, og
# tilkoblingsstrengene utledes fra dem — de MÅ være satt, ellers får appen
# «password authentication failed». Verdiene under er kun for lokal utvikling;
# i produksjon settes de som hemmeligheter i driftsmiljøet.
LIVSARKIV_APP_PASSORD=lokal-app
LIVSARKIV_AUTH_PASSORD=lokal-auth

# Valgfritt — overstyrer utledningen over.
# DATABASE_URL=postgres://livsarkiv_app@localhost:5432/livsarkiv
# DATABASE_URL_AUTH=postgres://livsarkiv_auth@localhost:5432/livsarkiv

PORT=3400

# Karenstid i sekunder (48 timer i produksjon; settes lavt i test).
KARENSTID_SEKUNDER=172800

# Selvregistrering for eiere. Av i produksjon til DPIA og vilkår er klare.
REGISTRERING_AAPEN=0

# Innloggingsforsøk per klient-IP per kvarter (kontoen vernes uansett av taket
# på 10 per e-post). Sett 30 for et strammere tak.
LOGIN_PER_IP_KVARTER=100

# E-postutsending (valgfritt, provider-agnostisk JSON-API). Uten oppsett
# logges varslene kun som hendelsestyper.
EPOST_API_URL=
EPOST_API_NOKKEL=
EPOST_FRA=

# Folkeregister-trigger (ADR-008). Uten begge gjør ingest ingenting.
# FNR_PEPPER må ligge HER og aldri i databasen — en databasedump alene skal
# ikke være nok til å regne seg tilbake til et fødselsnummer.
FOLKEREGISTER_URL=
FOLKEREGISTER_TOKEN=
FNR_PEPPER=
